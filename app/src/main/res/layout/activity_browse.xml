<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_pad_h"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/screen_pad_h">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="@color/asc_text"
                android:textSize="@dimen/title_text"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/nav_refresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_pill"
                android:clickable="true"
                android:contentDescription="Atualizar lista"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_search_top"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_pill"
            android:clickable="true"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:text="Pesquisar"
            android:textColor="@color/asc_text2"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/group_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <com.ascplay.app.CategoryChips
                android:id="@+id/lv_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/gv_items"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:cacheColorHint="@android:color/transparent"
                android:clipToPadding="false"
                android:columnWidth="@dimen/grid_col_w"
                android:horizontalSpacing="0dp"
                android:listSelector="@android:color/transparent"
                android:numColumns="3"
                android:paddingBottom="@dimen/nav_clear"
                android:scrollbars="none"
                android:stretchMode="columnWidth"
                android:verticalSpacing="0dp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="Carregando..."
                android:textColor="@color/asc_text2"
                android:textSize="18sp" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_fade_bottom"
        android:clickable="false" />

    <include
        android:id="@+id/group_nav"
        layout="@layout/layout_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="@dimen/nav_margin"
        android:layout_marginRight="@dimen/nav_margin"
        android:layout_marginBottom="@dimen/nav_margin"
        android:visibility="gone" />

</FrameLayout>
