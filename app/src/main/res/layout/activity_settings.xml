<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_pad_h"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/screen_pad_h"
        android:paddingBottom="@dimen/nav_clear">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajustes"
            android:textColor="@color/asc_text"
            android:textSize="@dimen/title_text"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/lv_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:scrollbars="none" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_home"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tv_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:text="Escolha uma opção acima."
                android:textColor="@color/asc_text"
                android:textSize="@dimen/detail_text" />
        </ScrollView>
    </LinearLayout>

    <include
        android:id="@+id/group_nav"
        layout="@layout/layout_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="@dimen/nav_margin"
        android:layout_marginRight="@dimen/nav_margin"
        android:layout_marginBottom="@dimen/nav_margin"
        android:visibility="gone" />
</FrameLayout>
