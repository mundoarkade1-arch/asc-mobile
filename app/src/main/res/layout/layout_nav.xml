<?xml version="1.0" encoding="utf-8"?>
<!-- Navegação inferior: cápsula de vidro flutuante com 5 itens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_nav"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:contentDescription="Início"
        android:drawableTop="@drawable/ic_nav_home"
        android:drawablePadding="2dp"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:text="Início"
        android:textColor="@color/nav_text"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/nav_live"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:contentDescription="Canais"
        android:drawableTop="@drawable/ic_nav_live"
        android:drawablePadding="2dp"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:text="Canais"
        android:textColor="@color/nav_text"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/nav_movie"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:contentDescription="Filmes"
        android:drawableTop="@drawable/ic_nav_movie"
        android:drawablePadding="2dp"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:text="Filmes"
        android:textColor="@color/nav_text"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/nav_series"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:contentDescription="Séries"
        android:drawableTop="@drawable/ic_nav_series"
        android:drawablePadding="2dp"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:text="Séries"
        android:textColor="@color/nav_text"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/nav_settings"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:contentDescription="Ajustes"
        android:drawableTop="@drawable/ic_nav_settings"
        android:drawablePadding="2dp"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:text="Ajustes"
        android:textColor="@color/nav_text"
        android:textSize="11sp" />

</LinearLayout>
