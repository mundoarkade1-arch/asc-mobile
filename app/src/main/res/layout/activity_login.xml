<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/login_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_card_home"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:id="@+id/group_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#4ADE80"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_update_now"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/btn_min_h"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button"
                        android:text="@string/btn_update_now"
                        android:textAllCaps="false"
                        android:textColor="@color/asc_text"
                        android:textSize="@dimen/btn_text" />

                    <Button
                        android:id="@+id/btn_update_later"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/btn_min_h"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_pill"
                        android:text="@string/btn_update_later"
                        android:textAllCaps="false"
                        android:textColor="@color/asc_text"
                        android:textSize="@dimen/btn_text" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="ASC Mobile"
                android:src="@drawable/ic_brand" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="ASC Mobile"
                android:textColor="@color/asc_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/login_title"
                android:textColor="@color/asc_text2"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_mode_xtream"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_min_h"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:text="@string/mode_xtream"
                    android:textAllCaps="false"
                    android:textColor="@color/asc_text"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_mode_m3u"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_min_h"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:text="@string/mode_m3u"
                    android:textAllCaps="false"
                    android:textColor="@color/asc_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/group_xtream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <EditText
                android:id="@+id/et_server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_field"
                android:hint="@string/hint_server"
                android:imeOptions="actionNext"
                android:inputType="textUri"
                android:minHeight="@dimen/field_min_h"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/asc_text"
                android:textColorHint="#8FA6CC"
                android:textSize="@dimen/field_text" />

            <EditText
                android:id="@+id/et_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_field"
                android:hint="@string/hint_user"
                android:imeOptions="actionNext"
                android:inputType="textNoSuggestions"
                android:minHeight="@dimen/field_min_h"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/asc_text"
                android:textColorHint="#8FA6CC"
                android:textSize="@dimen/field_text" />

            <EditText
                android:id="@+id/et_pass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_field"
                android:hint="@string/hint_pass"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:minHeight="@dimen/field_min_h"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/asc_text"
                android:textColorHint="#8FA6CC"
                android:textSize="@dimen/field_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/group_m3u"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <EditText
                android:id="@+id/et_m3u"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_field"
                android:hint="@string/hint_m3u"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:minHeight="@dimen/field_min_h"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/asc_text"
                android:textColorHint="#8FA6CC"
                android:textSize="@dimen/field_text" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_enter"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button"
                android:text="@string/btn_enter"
                android:textAllCaps="false"
                android:textColor="@color/asc_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/asc_text2"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
