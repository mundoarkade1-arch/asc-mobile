<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical"
    android:padding="@dimen/screen_pad_h">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="@dimen/series_cover_w"
            android:layout_height="@dimen/series_cover_h"
            android:background="@drawable/bg_home_image"
            android:clipToOutline="true"
            android:contentDescription="Capa"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/asc_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/asc_blue_light"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:focusable="false"
                android:maxLines="@integer/series_plot_lines"
                android:textColor="@color/asc_text2"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_watch"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_min_h"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button"
            android:text="Assistir"
            android:textAllCaps="false"
            android:textColor="@color/asc_text"
            android:textSize="@dimen/btn_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_continue"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_min_h"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_pill"
            android:text="Continuar"
            android:textAllCaps="false"
            android:textColor="@color/asc_text"
            android:textSize="@dimen/btn_text"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_season"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_min_h"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip"
        android:text="Temporada 1"
        android:textAllCaps="false"
        android:textColor="@color/asc_text"
        android:textSize="@dimen/btn_text" />

    <GridView
        android:id="@+id/gv_episodes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:cacheColorHint="@android:color/transparent"
        android:clipToPadding="false"
        android:columnWidth="48dp"
        android:horizontalSpacing="0dp"
        android:listSelector="@android:color/transparent"
        android:numColumns="6"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ListView
            android:id="@+id/lv_seasons"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ListView
                android:id="@+id/lv_episodes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="Carregando..."
                android:textColor="@color/asc_text2"
                android:textSize="18sp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
