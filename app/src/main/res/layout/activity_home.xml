<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:id="@+id/scroll_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/nav_clear"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_pad_h"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/screen_pad_h">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="ASC play"
                    android:src="@drawable/ic_brand" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Olá, bem-vindo"
                        android:textColor="@color/asc_text2"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ASC play"
                        android:textColor="@color/asc_text"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/nav_refresh"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_glass_pill"
                    android:clickable="true"
                    android:contentDescription="Atualizar lista"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_refresh" />

                <ImageView
                    android:id="@+id/btn_search_home"
                    android:layout_width="64dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_glass_pill"
                    android:clickable="true"
                    android:contentDescription="Pesquisar"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_search" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/group_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_banner_panel"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/asc_text"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_update_now"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/btn_min_h"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button"
                        android:text="@string/btn_update_now"
                        android:textAllCaps="false"
                        android:textColor="@color/asc_text"
                        android:textSize="@dimen/btn_text" />

                    <Button
                        android:id="@+id/btn_update_later"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/btn_min_h"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_pill"
                        android:text="@string/btn_update_later"
                        android:textAllCaps="false"
                        android:textColor="@color/asc_text"
                        android:textSize="@dimen/btn_text" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/banner_featured"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_home_image"
                android:clipToOutline="true"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_banner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_banner_panel"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tv_banner_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/asc_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_banner_play"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/btn_min_h"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button"
                        android:minWidth="140dp"
                        android:text="Assistir"
                        android:textAllCaps="false"
                        android:textColor="@color/asc_text"
                        android:textSize="@dimen/btn_text"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/group_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:text="Continue assistindo"
                    android:textColor="@color/asc_text"
                    android:textSize="@dimen/section_text"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/rail_h_poster"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/rail_continue"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:clipChildren="false"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ao vivo agora"
                    android:textColor="@color/asc_text"
                    android:textSize="@dimen/section_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/more_live"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="Ver todos"
                    android:textColor="@color/asc_blue_light"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/st_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Carregando..."
                android:textColor="@color/asc_text2"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="@dimen/rail_h_channel"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rail_live"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Filmes em alta"
                    android:textColor="@color/asc_text"
                    android:textSize="@dimen/section_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/more_movie"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="Ver todos"
                    android:textColor="@color/asc_blue_light"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/st_movie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Carregando..."
                android:textColor="@color/asc_text2"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="@dimen/rail_h_poster"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rail_movie"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Séries em alta"
                    android:textColor="@color/asc_text"
                    android:textSize="@dimen/section_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/more_series"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="Ver todos"
                    android:textColor="@color/asc_blue_light"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/st_series"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Carregando..."
                android:textColor="@color/asc_text2"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="@dimen/rail_h_poster"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rail_series"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_fade_bottom"
        android:clickable="false" />

    <include
        android:id="@+id/group_nav"
        layout="@layout/layout_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="@dimen/nav_margin"
        android:layout_marginRight="@dimen/nav_margin"
        android:layout_marginBottom="@dimen/nav_margin" />
</FrameLayout>
