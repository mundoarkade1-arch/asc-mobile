<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#5AAAFF" /><corners android:radius="26dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#2F7DFF" /><stroke android:width="2.5dp" android:color="#FFFFFF" /><corners android:radius="26dp" /></shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#552F7DFF" /><corners android:radius="26dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#2F7DFF" /><corners android:radius="26dp" /></shape>
    </item>
</selector>
